# Copy to apps/api/.env.test and leave as-is to get working integration tests against the
# isolated, disposable test Postgres instance started by `pnpm infra:test:up`.
#
# This file is read ONLY by integration tests (see jest.integration.config.js) — never by
# the running API, never by `pnpm db:*` commands, and never merged with apps/api/.env. The
# variable name is deliberately TEST_DATABASE_URL, not DATABASE_URL, so a missing or
# misconfigured test config can never silently fall back to the operational database.
#
# Local-dev-only credential, not a real secret — matches scripts/db/init-test-role.sql.
TEST_DATABASE_URL=postgresql://zentuva_test:local-dev-only-not-a-real-password@localhost:5433/zentuva_test
