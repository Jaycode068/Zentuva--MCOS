# Copy to .env — this is the file NestJS reads (via @nestjs/config) when you run
# `pnpm dev` or `pnpm --filter @zentuva/api run dev` directly on the host.
#
# DATABASE_URL and REDIS_URL point at localhost because apps/api runs on the host while
# Postgres/Redis run in Docker (`pnpm infra:up`), which publishes their ports to
# localhost. If you instead run the full containerized stack
# (docker-compose.production.yml), that file overrides DATABASE_URL/REDIS_URL to point
# at the `postgres`/`redis` service names — you don't need to change this file for that.

NODE_ENV=development
PORT=4000

# Postgres connection string used by Prisma.
DATABASE_URL=postgresql://zentuva:zentuva@localhost:5432/zentuva

# Redis connection string used by BullMQ.
REDIS_URL=redis://localhost:6379

# Authentication Layer (Sprint 1B.2). Nothing here is optional in a real deployment —
# the app refuses to boot without valid secrets (apps/api/src/config/env.validation.ts).
# Generate real secrets with, e.g.: openssl rand -base64 48
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST be different values.
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string-before-first-boot-access
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string-before-boot
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
MAX_LOGIN_ATTEMPTS=5

# `POST /auth/password/request-reset` has NO email integration yet — there is no email
# provider wired up anywhere in this codebase. When NODE_ENV=development, the response
# body includes the raw reset token directly so you can test the flow without email. In
# every other NODE_ENV, the token is never returned in the response — a future sprint must
# add real email delivery before this endpoint is usable in production; until then,
# password reset in production has no way to reach the user.

# Identity Domain seed data (`pnpm db:seed` — apps/api/prisma/seed.ts). Required: the
# seed script fails loudly if these are missing rather than falling back to a hardcoded
# credential. SEED_ADMIN_FIRST_NAME/SEED_ADMIN_LAST_NAME are optional (default to a
# generic "Organisation Owner").
SEED_ADMIN_EMAIL=owner@bobybites.example
SEED_ADMIN_PASSWORD=change-me-before-seeding
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
