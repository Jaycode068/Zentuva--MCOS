// Zentuva MCOS — Prisma schema
//
// Identity Domain (Sprint 1B.1) — implemented exactly per the approved design in
// docs/domains/identity.md §9, as refined in Sprint 1A.1 (organisationCode, employeeCode,
// UserStatus.LOCKED). This is the persistent foundation every future domain module
// (Product Catalogue, Procurement, Inventory, Production, Sales, Distribution, Finance)
// will depend on for tenant scoping and authorization — see identity.md §1.
//
// Database & Domain Layer only (Sprint 1B.1): no authentication, JWT, login, or permission
// evaluation logic has been implemented against this schema yet. See
// docs/sprint-1B.1-completion-report.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganisationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// The tenant boundary — see identity.md §2 ("What is a Tenant?"). Every tenant-scoped
/// table in every domain carries an `organisationId` foreign key pointing here.
model Organisation {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  /// Immutable, human-readable identifier (e.g. "BBT-0001"). See identity.md §3
  /// "Organisation Code" — never exposed on any update path.
  organisationCode String             @unique
  businessEmail    String
  country          String
  status           OrganisationStatus @default(PENDING)

  // Profile fields — see identity.md §3 "Organisation Profile". All optional; filled in
  // after registration.
  /// Shorter/friendlier public-facing name, distinct from the legal `name`. Added Sprint
  /// 2.1 — not part of the original identity.md design, see
  /// docs/sprint-2.1-completion-report.md "Deviations".
  displayName        String?
  logoUrl            String?
  /// Optional alternate logo shown on dark backgrounds/dark theme — Sprint 3.4 Branding
  /// tab "Dark Logo". Falls back to `logoUrl` (or the initials avatar) when absent.
  darkLogoUrl        String?
  description        String?
  industry           String?
  /// Sprint 3.4 Business tab wire name is "Manufacturing Sector" — reuses this
  /// pre-existing, previously-unused column rather than adding a new one.
  businessType       String?
  phone              String?
  website            String?
  supportEmail       String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  currency           String  @default("USD")
  timeZone           String  @default("UTC")
  fiscalYearStart    Int     @default(1)
  dateFormat         String  @default("YYYY-MM-DD")
  /// Added Sprint 3.4 Regional tab. "HH:mm" (24-hour) or "hh:mm a" (12-hour).
  timeFormat         String  @default("HH:mm")
  /// Added Sprint 3.4 Regional tab. A display pattern, e.g. "1,234.56" or "1.234,56" —
  /// interpreted by the frontend, not parsed/validated server-side beyond being a string.
  numberFormat       String  @default("1,234.56")
  /// Added Sprint 3.4 Branding tab — hex strings (e.g. "#7C3AED"), applied as CSS custom
  /// property overrides client-side. `null` means "use the Zentuva default palette."
  /// Deliberately does NOT include a purple/brand-identity override — see
  /// docs/sprint-3.4-completion-report.md "Branding architecture": deep purple stays
  /// Zentuva's own platform identity across every tenant, only the interactive
  /// primary/accent layer is tenant-customisable.
  primaryColor       String?
  accentColor        String?
  /// Added Sprint 3.4 Business tab.
  registrationNumber String?
  taxId              String?
  /// A free-form count or bucket (e.g. "25" or "11-50") rather than a strict Int, so an
  /// organisation isn't forced to guess an exact headcount.
  employeeCount      String?
  /// Structured, low-cardinality settings that don't warrant their own columns — Sprint
  /// 3.4 Branding's `theme` and every Workspace Preferences toggle live here, per the
  /// brief's "if settings become numerous, store as JSON" guidance. Shape documented in
  /// `apps/api/src/identity/organisation/workspace-settings.ts`
  /// (`DEFAULT_WORKSPACE_SETTINGS`) — deep-merged with this column's contents on every
  /// read so older rows (and a fresh `{}`) still return complete, defaulted values.
  settings           Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                            User[]
  roles                            Role[]
  invitations                      Invitation[]
  auditLogs                        AuditLog[]
  sessions                         Session[]
  userRoles                        UserRole[]
  /// Added Sprint 4.1 — Product Catalogue (docs/domains/catalogue.md).
  products                         Product[]
  /// Added Sprint 4.2 — Supplier Management (docs/domains/suppliers.md).
  suppliers                        Supplier[]
  /// Added Sprint 4.3 — Procurement (docs/domains/procurement.md).
  purchaseOrders                   PurchaseOrder[]
  /// Added Sprint 4.4 — Inventory (docs/domains/inventory.md).
  goodsReceipts                    GoodsReceipt[]
  inventoryStock                   InventoryStock[]
  inventoryTransactions            InventoryTransaction[]
  /// Added Sprint 4.5 — Inventory Locations (docs/domains/inventory.md).
  inventoryLocations               InventoryLocation[]
  /// Added Sprint 4.6 — Production & Bill of Materials (docs/domains/production.md).
  billOfMaterials                  BillOfMaterial[]
  productionOrders                 ProductionOrder[]
  productionMaterialIssues         ProductionMaterialIssue[]
  productionRuns                   ProductionRun[]
  /// Added Sprint 4.7 — Product Family, Variant & SKU Architecture (docs/domains/catalogue.md).
  productFamilies                  ProductFamily[]
  productVariants                  ProductVariant[]
  /// Added Sprint 4.8 — Customer, Territory, Outlet & Retail Network
  /// (docs/domains/retail-network.md).
  territories                      Territory[]
  customers                        Customer[]
  outlets                          Outlet[]
  outletPhotos                     OutletPhoto[]
  distributionNetworkRelationships DistributionNetworkRelationship[]
  /// Added Sprint 4.8 — Sales (docs/domains/sales.md).
  salesOrders                      SalesOrder[]
  /// Added Sprint 4.9 — Sales Fulfilment (docs/domains/sales.md "Fulfilment").
  salesFulfilments                 SalesFulfilment[]
  /// Added Sprint 5 — Distribution & Delivery (docs/domains/distribution.md).
  dispatches                       Dispatch[]
  deliveries                       Delivery[]
  /// Added Sprint 6 — Finance (docs/domains/finance.md).
  invoices                         Invoice[]
  payments                         Payment[]
  creditNotes                      CreditNote[]

  @@map("organisations")
}

/// A single human's login identity within one Organisation. MVP: one Organisation per
/// User (see identity.md §2 "Can users belong to multiple organisations?").
model User {
  id                  String     @id @default(cuid())
  organisationId      String
  email               String     @unique
  /// Optional — future HR-module / staff-identification use case. No generation logic
  /// or uniqueness constraint in MVP (identity.md §4, added Sprint 1A.1).
  employeeCode        String?
  firstName           String
  lastName            String
  /// Optional — Sprint 3.3 "My Profile" page. No format validation beyond the shared
  /// Zod schema (identity.md doesn't specify one).
  phoneNumber         String?
  /// Profile photo — added when the Sprint 3.3 "placeholder only" avatar became a real
  /// upload. Same `FileStorage` port + absolute-URL pattern as `Organisation.logoUrl`
  /// (Sprint 3.4); `avatarKey` is the opaque storage key needed to delete the old file on
  /// replace/remove — kept as its own column (not stashed in a settings blob) since User
  /// has no JSON settings bucket the way Organisation does.
  avatarUrl           String?
  avatarKey           String?
  passwordHash        String
  status              UserStatus @default(INVITED)
  /// Forces a redirect to `/change-password` on next login before the user can continue
  /// (Sprint 3.3 §5). Set `true` when an Administrator creates a user with a temporary
  /// password (Sprint 2.2 `createUser`); left `false` for self-service registration and
  /// invitation acceptance, since both of those flows already have the user choose their
  /// own password. Cleared automatically whenever a password is set via change-password
  /// or reset-password.
  mustChangePassword  Boolean    @default(false)
  /// Stamped every time the password is set via change-password or reset-password (never
  /// at initial creation) — Sprint 3.3 Security page's "Password Last Changed".
  passwordChangedAt   DateTime?
  /// Consecutive failed login attempts since the last success. Reset to 0 on successful
  /// login; reaching MAX_LOGIN_ATTEMPTS (env-configured) transitions status to LOCKED.
  /// Added Sprint 1B.2 — identity.md's LOCKED status (§4, added 1A.1) deliberately left
  /// "exact triggering/unlocking rules" as a Sprint 1B implementation detail; this is
  /// that detail, not a redesign.
  failedLoginAttempts Int        @default(0)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  sessions        Session[]
  sentInvitations Invitation[]         @relation("InvitedBy")
  passwordResets  PasswordResetToken[]

  @@index([organisationId])
  @@map("users")
}

/// A named, organisation-scoped bundle of permissions. Three system roles (Owner,
/// Administrator, Member) are seeded per-organisation; see identity.md §6.
model Role {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  description    String?
  /// System roles (Owner/Administrator/Member) cannot be renamed or deleted — enforced at
  /// the application layer (RoleRepository/RoleService), not the database.
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("roles")
}

/// A single granular capability (e.g. "identity.users.invite"). The only genuinely
/// global (non-tenant-scoped) table in the domain — see identity.md §7.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  domain      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([domain])
  @@map("permissions")
}

/// Join: "this user has this role." `organisationId` is denormalised (derivable via
/// `role.organisationId`) so tenant-isolation queries never need to join through Role —
/// see identity.md §7.
model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organisationId String
  assignedById   String?
  assignedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([organisationId])
  @@map("user_roles")
}

/// Join: "this role grants this capability." Not applicable to the `Owner` role, which
/// bypasses this table entirely — see identity.md §6.
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// A pending offer for someone to join an Organisation with a specific Role. See
/// identity.md §4/§5 for the full lifecycle and acceptance flow.
model Invitation {
  id             String           @id @default(cuid())
  organisationId String
  email          String
  roleId         String
  invitedById    String
  /// Only the hash is ever stored — the raw token exists only in the email link at
  /// issuance time. See identity.md §9 "Token storage".
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organisationId, email])
  @@map("invitations")
}

/// One logged-in device/browser for one User. The parent record RefreshTokens rotate
/// underneath — see identity.md §4/§5. No login/logout logic writes to this table yet
/// (Sprint 1B.1 is schema-only for this entity).
model Session {
  id             String    @id @default(cuid())
  userId         String
  organisationId String
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  revokedAt      DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([organisationId])
  @@map("sessions")
}

/// The rotating credential material for a Session. `replacedByTokenId` forms a rotation
/// chain used for reuse/theft detection — see identity.md §5/§9. No refresh-token logic
/// writes to this table yet (Sprint 1B.1 is schema-only for this entity).
model RefreshToken {
  id                String    @id @default(cuid())
  sessionId         String
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique

  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacesToken   RefreshToken? @relation("TokenRotation")

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// A single-use, time-limited credential for the forgot-password flow. Included per the
/// full documented schema (identity.md §9), even though the Sprint 1B.1 brief's Required
/// Entities list omits it — see docs/sprint-1B.1-completion-report.md "Deviations". No
/// password-reset logic writes to this table yet.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// An immutable, insert-only record of a significant event — see identity.md §8. Every
/// future domain is expected to write into this table directly.
model AuditLog {
  id             String   @id @default(cuid())
  organisationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Hardcoded per the Sprint 4.1 brief ("Category" — not a Categories table; a full
/// taxonomy is future scope once Procurement/Inventory need it).
enum ProductCategory {
  SNACKS
  BEVERAGE
  WATER
  CONFECTIONERY
  RAW_MATERIALS
  PACKAGING
  OTHERS
}

enum ProductType {
  FINISHED_PRODUCT
  RAW_MATERIAL
  PACKAGING_MATERIAL
  /// Added Sprint 4.3 (docs/domains/procurement.md) — a third Purchase-Order-eligible type
  /// alongside Raw Material/Packaging Material (e.g. factory supplies that aren't inputs
  /// to a recipe or a package, like cleaning agents or machine lubricant).
  CONSUMABLE
}

/// Draft -> Active -> Archived. Products are never physically deleted (Sprint 4.1 brief);
/// Archived is the terminal "removed from active use" state.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The Product Catalogue (Sprint 4.1, docs/domains/catalogue.md) — the master source of
/// truth for everything an Organisation manufactures or sells. Every future manufacturing
/// module (Inventory, Production, Sales, ...) is expected to reference `Product.id` rather
/// than duplicating product data, per the brief's "master source of truth" framing.
model Product {
  id               String          @id @default(cuid())
  organisationId   String
  /// Auto-generated (`PRD-000001`, ...), globally unique, immutable — see
  /// `ProductRepository.generateUniqueCode`. Never accepted on create or update input.
  code             String          @unique
  name             String
  /// Optional customer-facing name, distinct from the internal `name` — same pattern as
  /// `Organisation.displayName` (Sprint 2.1).
  displayName      String?
  /// Derived from `name` at creation time (deduped within the organisation on collision)
  /// and left fixed afterward — not used in routing this sprint (the API is `:id`-based),
  /// reserved for future customer-facing catalogue pages.
  slug             String
  category         ProductCategory
  type             ProductType
  shortDescription String?
  longDescription  String?
  /// Free text (Sprint 4.1 brief: "Store as text") — the frontend offers a fixed set of
  /// common values (Piece, Pack, Carton, Bottle, Sachet, Kilogram, Gram, Litre) via a
  /// dropdown, but nothing here enforces that list, same convention as
  /// `Organisation.currency`/`dateFormat` (Sprint 1B.1/3.4: free-text columns, constrained
  /// dropdowns in the UI only).
  unit             String
  /// Single product image — same `FileStorage` port + absolute-URL pattern as
  /// `Organisation.logoUrl` (Sprint 3.4) and `User.avatarUrl` (Sprint 3.5). `imageKey` is
  /// the opaque storage key needed to delete the old file on replace/remove.
  imageUrl         String?
  imageKey         String?
  status           ProductStatus   @default(DRAFT)
  /// Plain ids, no FK relation — same convention as `AuditLog.actorUserId`, since this is
  /// metadata about who acted, not a relationship the Product aggregate depends on.
  createdById      String?
  updatedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  /// Added Sprint 4.7 — Product Family, Variant & SKU Architecture
  /// (docs/domains/catalogue.md). Nullable — raw materials/packaging/consumables, and any
  /// pre-existing finished product never migrated into the hierarchy, simply have no
  /// variant. `onDelete: SetNull` (not `Restrict` like every other FK into `Product`) is
  /// deliberate: this is the one FK pointing *out* of the transactional SKU into an
  /// optional grouping label, not the reverse — the SKU must never be blocked or cascaded
  /// away by anything happening to its variant.
  productVariantId String?

  organisation                 Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  productVariant               ProductVariant?               @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  /// Added Sprint 4.3 — Procurement (docs/domains/procurement.md). Only products whose
  /// `type` is Raw Material/Packaging Material/Consumable may actually appear here — see
  /// `PurchaseOrderService`'s product-type validation.
  purchaseOrderItems           PurchaseOrderItem[]
  /// Added Sprint 4.4 — Inventory (docs/domains/inventory.md).
  goodsReceiptItems            GoodsReceiptItem[]
  inventoryStock               InventoryStock[]
  inventoryTransactions        InventoryTransaction[]
  /// Added Sprint 4.6 — Production & Bill of Materials (docs/domains/production.md).
  /// `billOfMaterials`/`billOfMaterialItems` cover this product appearing as either the
  /// finished output of a recipe or one of its components — a product may legitimately
  /// be referenced by both relations, just never within the same `BillOfMaterial` row
  /// (see `BillOfMaterialItem`'s finished-vs-component type restriction, service-enforced).
  billOfMaterials              BillOfMaterial[]
  billOfMaterialItems          BillOfMaterialItem[]
  productionOrders             ProductionOrder[]
  productionOrderItems         ProductionOrderItem[]
  productionMaterialIssueItems ProductionMaterialIssueItem[]
  /// Added Sprint 4.8 — Sales (docs/domains/sales.md). Only `FINISHED_PRODUCT` SKUs may
  /// actually appear here — service-enforced in `SalesOrderService.buildItems`, mirroring
  /// `purchaseOrderItems`' inverse type restriction.
  salesOrderItems              SalesOrderItem[]
  /// Added Sprint 4.9 — Sales Fulfilment (docs/domains/sales.md "Fulfilment").
  salesFulfilmentItems         SalesFulfilmentItem[]
  /// Added Sprint 5 — Distribution & Delivery (docs/domains/distribution.md).
  dispatchItems                DispatchItem[]
  deliveryItems                DeliveryItem[]
  /// Added Sprint 6 — Finance (docs/domains/finance.md).
  invoiceItems                 InvoiceItem[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([productVariantId])
  @@map("products")
}

/// Added Sprint 4.7 — Product Family, Variant & SKU Architecture
/// (docs/domains/catalogue.md). A logical commercial/manufacturing grouping used purely
/// for organisation, navigation, and future reporting — never a transactional target
/// itself. BOM/Production/Inventory continue to reference `Product` (the SKU) directly;
/// see `ProductVariant`/`Product.productVariantId`.
enum ProductFamilyStatus {
  ACTIVE
  INACTIVE
}

model ProductFamily {
  id             String              @id @default(cuid())
  organisationId String
  /// Auto-generated (`FAM-000001`, ...), globally unique, immutable — see
  /// `ProductFamilyService.generateUniqueCode`.
  code           String              @unique
  name           String
  description    String?
  /// No delete — same "deactivate, never remove" convention as every other domain
  /// entity. `ACTIVE`/`INACTIVE` only (not Product's 3-state Draft/Active/Archived
  /// lifecycle) since a family's status only gates "is this selectable when creating a
  /// new variant," not a cross-domain business rule — same shape as `LocationStatus`.
  status         ProductFamilyStatus @default(ACTIVE)
  createdById    String?
  updatedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@map("product_families")
}

/// A meaningful recipe/formulation variation within a `ProductFamily` (e.g. "Sweet &
/// Spicy — Ripe Plantain"). Groups one or more `Product` SKUs (pack sizes); never itself
/// a BOM/Production/Inventory target — see `Product.productVariantId`.
enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}

model ProductVariant {
  id              String               @id @default(cuid())
  organisationId  String
  productFamilyId String
  /// Auto-generated (`VAR-000001`, ...), globally unique, immutable — see
  /// `ProductVariantService.generateUniqueCode`.
  code            String               @unique
  name            String
  description     String?
  status          ProductVariantStatus @default(ACTIVE)
  createdById     String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `onDelete: Restrict` — an internal domain FK (no delete endpoint exists for either
  /// entity this sprint, but this is the safe default matching every other in-domain FK
  /// in this codebase).
  productFamily ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Restrict)
  products      Product[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([productFamilyId])
  @@map("product_variants")
}

/// Hardcoded per the Sprint 4.2 brief ("Use an enum") — allows Procurement to later filter
/// suppliers by what they supply.
enum SupplierCategory {
  RAW_MATERIAL
  PACKAGING
  LOGISTICS
  MAINTENANCE
  UTILITY
  SERVICE
  OTHER
}

/// No Draft/Archived states like Product — a supplier is either usable (Active) or not
/// (Inactive). Inactive suppliers cannot receive future Purchase Orders (Sprint 4.3+,
/// out of scope here) but the row is never physically deleted (Sprint 4.2 brief: "Do not
/// implement delete. Suppliers should instead become INACTIVE").
enum SupplierStatus {
  ACTIVE
  INACTIVE
}

/// Supplier Management (Sprint 4.2, docs/domains/suppliers.md) — the master record of
/// every vendor an Organisation buys goods or services from. Deliberately NOT Procurement:
/// no Purchase Orders, Goods Receiving, Invoices, or Product–Supplier relationships live
/// here (brief's explicit "This is not Procurement" / Out of Scope list) — this table only
/// answers "who do we buy from?"; Sprint 4.3 Procurement is expected to reference
/// `Supplier.id` instead of a free-text supplier name.
model Supplier {
  id                      String           @id @default(cuid())
  organisationId          String
  /// Auto-generated (`SUP-000001`, ...), globally unique, immutable — same
  /// collision-avoidance pattern as `Product.code` (Sprint 4.1). Never accepted on create
  /// or update input.
  supplierCode            String           @unique
  supplierName            String
  /// Optional customer/PO-facing name, distinct from the legal `supplierName` — same
  /// pattern as `Organisation.displayName`/`Product.displayName`.
  displayName             String?
  contactPerson           String?
  email                   String?
  phoneNumber             String?
  website                 String?
  country                 String?
  state                   String?
  city                    String?
  address                 String?
  taxIdentificationNumber String?
  supplierCategory        SupplierCategory
  status                  SupplierStatus   @default(ACTIVE)
  notes                   String?
  /// Plain ids, no FK relation — same convention as `AuditLog.actorUserId`/
  /// `Product.createdById` (metadata about who acted, not a relationship the aggregate
  /// depends on).
  createdById             String?
  updatedById             String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Added Sprint 4.3 — Procurement (docs/domains/procurement.md).
  purchaseOrders PurchaseOrder[]
  /// Added Sprint 4.4 — Inventory (docs/domains/inventory.md).
  goodsReceipts  GoodsReceipt[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, supplierCategory])
  @@map("suppliers")
}

/// Draft -> Pending -> (Approved ->) Partially Received -> Received, or Cancelled.
/// Sprint 4.3 only reached Draft/Pending/Cancelled. Sprint 4.4 added `RECEIVED` via
/// `InventoryService.receiveGoods`. Sprint 4.4.1 (docs/domains/inventory.md
/// "Receiving Model") added `PARTIALLY_RECEIVED` and made receiving repeatable: a
/// Purchase Order may now have many Goods Receipts, and its status reflects delivery
/// completeness — `deliveredQuantity` vs `orderedQuantity` per line, summed across every
/// receipt — not acceptance/rejection, which is tracked separately per receipt via
/// `GoodsReceipt.discrepancyStatus`. `APPROVED` remains reserved for a future approval
/// workflow. Purchase orders are never physically deleted (brief: "No DELETE. Cancelled
/// POs remain in history"), and once receiving has started
/// (`PARTIALLY_RECEIVED`/`RECEIVED`) a PO can no longer be edited or cancelled — see
/// `PurchaseOrderService.update`/`cancel`.
enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Procurement (Sprint 4.3, docs/domains/procurement.md) — a request to buy goods from a
/// Supplier. This sprint covers the purchasing workflow up to the point a PO has been
/// issued to a supplier (`PENDING`); goods receiving into Inventory is explicitly out of
/// scope (Sprint 4.4).
model PurchaseOrder {
  id                   String              @id @default(cuid())
  organisationId       String
  /// Auto-generated (`PO-000001`, ...), globally unique, immutable — same
  /// collision-avoidance pattern as `Product.code`/`Supplier.supplierCode`.
  purchaseOrderNumber  String              @unique
  supplierId           String
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(DRAFT)
  remarks              String?
  /// Server-calculated, never trusted from the client — see
  /// `PurchaseOrderService.buildItems`. Sum of every line's `lineTotal`.
  subtotal             Float
  /// `subtotal` with no taxes or discounts applied (Sprint 4.3 brief: "No taxes or
  /// discounts in MVP") — kept as its own column rather than always reading `subtotal`
  /// directly since Sales/Finance-style totals typically diverge from their subtotal once
  /// tax/discount logic exists, and this keeps that future migration additive.
  total                Float
  /// Plain ids, no FK relation — same convention as `AuditLog.actorUserId`/
  /// `Product.createdById`.
  createdById          String?
  updatedById          String?
  /// Always `null` in this sprint — no approval workflow exists yet (brief: "Do not
  /// implement approval workflow"). Reserved for when `APPROVED` becomes reachable.
  approvedById         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organisation  Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  /// Added Sprint 4.4 — Inventory (docs/domains/inventory.md). May now have many rows
  /// (Sprint 4.4.1 removed the "received once" restriction) — a short delivery, a
  /// rejection, or a vendor sending replacement goods each add another immutable
  /// `GoodsReceipt`, never editing a prior one.
  goodsReceipts GoodsReceipt[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, supplierId])
  @@map("purchase_orders")
}

/// One line of a PurchaseOrder — "buy this much of this product at this price." Only
/// products whose `type` is Raw Material/Packaging Material/Consumable may be referenced
/// (enforced in `PurchaseOrderService`, not the database) — Finished Products are rejected
/// since a manufacturer buys inputs, not its own output.
model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  unitPrice       Float
  /// Server-calculated as `quantity * unitPrice` — see `PurchaseOrderService.buildItems`.
  lineTotal       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Added Sprint 4.4.1 — every physical delivery against this line (across possibly
  /// many Goods Receipts) references it directly, so "ordered" always means this row's
  /// own `quantity`, never a value re-entered at receiving time.
  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

/// Sprint 4.5 (docs/domains/inventory.md "Stock Locations") — the minimum useful
/// multi-location concept: a named physical place stock can be held (a warehouse, a
/// store room, ...), deliberately not a full Warehouse Management System (brief §15: no
/// bins, shelves, zones, barcode scanning, or transfers between locations yet). Every
/// organisation has exactly one `isDefault` location (auto-created as "Main Warehouse"
/// on first use if none exists — see `InventoryLocationRepository.getOrCreateDefault`),
/// which Goods Receiving falls back to when no location is specified, so the existing
/// receiving flow never breaks.
model InventoryLocation {
  id             String         @id @default(cuid())
  organisationId String
  name           String
  /// No delete — same "deactivate, never remove" convention as `Supplier`/`Product`
  /// (brief §20: "Do not allow deleting locations that already have inventory
  /// history... Deactivation should preserve historical records"). In practice every
  /// location accumulates history immediately (Goods Receiving requires one), so this
  /// codebase never exposes a delete path for locations at all, matching the domain's
  /// no-hard-delete convention everywhere else.
  status         LocationStatus @default(ACTIVE)
  /// Exactly one location per organisation should have this `true` — the fallback
  /// target for Goods Receiving when the caller doesn't specify a location. Enforced in
  /// `InventoryLocationRepository`/`InventoryLocationService`, not a database
  /// constraint (Prisma has no native "at most one true per group" constraint).
  isDefault      Boolean        @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  goodsReceipts    GoodsReceipt[]
  stock            InventoryStock[]
  transactions     InventoryTransaction[]
  /// Added Sprint 4.6 — Production & Bill of Materials (docs/domains/production.md).
  productionOrders ProductionOrder[]
  /// Added Sprint 4.9 — Sales Fulfilment (docs/domains/sales.md "Fulfilment").
  salesFulfilments SalesFulfilment[]
  /// Added Sprint 5 — Distribution & Delivery (docs/domains/distribution.md). The only
  /// relation this sprint adds to `InventoryLocation` — `InventoryStock`/
  /// `InventoryTransaction` gain nothing, since Dispatch/Delivery never touch them.
  dispatches       Dispatch[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@map("inventory_locations")
}

/// `Supplier`/`Product` both use `ACTIVE`/`INACTIVE` for the same "usable vs. retired,
/// never deleted" distinction — reused here rather than inventing new enum values.
enum LocationStatus {
  ACTIVE
  INACTIVE
}

/// Inventory (Sprint 4.4, docs/domains/inventory.md) — Goods Receiving into stock. A
/// `GoodsReceipt` records one physical delivery event against a Purchase Order. Sprint
/// 4.4.1 removed the original "received once" restriction: a Purchase Order may now have
/// many Goods Receipts (a short delivery followed later by the remainder, a rejected
/// batch followed by a replacement, ...). Every `GoodsReceipt` row, once created, is
/// immutable — the only field ever updated afterward is `discrepancyStatus`/
/// `discrepancyNotes`, the lightweight supplier-resolution state described below, which
/// is deliberately *not* a correction to what was actually received.
model GoodsReceipt {
  id                 String            @id @default(cuid())
  organisationId     String
  /// Auto-generated (`GRN-000001`, ...), globally unique, immutable — same
  /// collision-avoidance pattern as `PurchaseOrder.purchaseOrderNumber`.
  goodsReceiptNumber String            @unique
  purchaseOrderId    String
  /// Denormalised from `PurchaseOrder.supplierId` at receiving time — a Goods Receipt is
  /// always "goods from this supplier," and this avoids every read joining through the
  /// Purchase Order just to show who delivered.
  supplierId         String
  /// Added Sprint 4.5 — which physical location the accepted goods were received into.
  /// Defaults to the organisation's default location when not specified (brief §17:
  /// "Do not break the existing Goods Receiving flow") — `InventoryService.receiveGoods`
  /// resolves it, never the client.
  locationId         String
  receivedDate       DateTime
  /// Plain id, no FK relation — same convention as `AuditLog.actorUserId`/
  /// `PurchaseOrder.createdById` (metadata about who acted, not a relationship the
  /// aggregate depends on). Always the authenticated caller — never accepted as free-text
  /// input.
  receivedById       String?
  remarks            String?
  /// Added Sprint 4.4.1 — a lightweight, manually-progressed status representing whether
  /// *this specific receipt's* shortfall/rejection still needs supplier resolution
  /// (replacement, credit, ...). Auto-set at creation (`PENDING_SUPPLIER` if any item on
  /// this receipt was rejected, `NONE` otherwise) and updatable afterward via
  /// `PATCH /api/inventory/goods-receipts/:id/discrepancy` — see
  /// docs/domains/inventory.md "Supplier Resolution". Deliberately not a full Supplier
  /// Claims/Returns/Credit-Note system (brief's explicit Architectural Constraints) —
  /// just enough to preserve that the discrepancy happened and track its resolution
  /// state.
  discrepancyStatus  DiscrepancyStatus @default(NONE)
  /// Free-text context for the current `discrepancyStatus` (e.g. "Supplier confirmed
  /// replacement ships next week") — the one field on this otherwise-immutable row that
  /// can change over time, alongside `discrepancyStatus` itself.
  discrepancyNotes   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organisation  Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location      InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([organisationId])
  @@index([organisationId, purchaseOrderId])
  @@index([locationId])
  @@map("goods_receipts")
}

/// Reasons a receiving inspector can give for rejecting some (or all) of a delivered
/// quantity — Sprint 4.4.1 brief §4, a simple structured field rather than a full Quality
/// Management System.
enum RejectionReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  WRONG_SPECIFICATION
  CONTAMINATED
  OTHER
}

/// One line of a Goods Receipt — distinguishes what physically arrived from what passed
/// inspection into usable stock. References `purchaseOrderItemId` directly (not just
/// `productId`) so "ordered quantity" is always read from that row's own immutable
/// `quantity`, never re-entered here — see docs/domains/inventory.md "Receiving Model".
model GoodsReceiptItem {
  id                  String           @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  /// Denormalised from `purchaseOrderItem.productId` — same rationale as
  /// `GoodsReceipt.supplierId` (avoids every read joining through the Purchase Order
  /// item just to show which product this line is).
  productId           String
  /// The physical quantity counted at receiving — may be less than ordered (short
  /// delivery), more than ordered (excess supply, brief §3 Scenario E — never silently
  /// capped), or zero rejected/all accepted.
  deliveredQuantity   Float
  /// The portion of `deliveredQuantity` rejected (defective, damaged, wrong item, ...).
  /// `0` by default — most receipts have no rejection at all.
  rejectedQuantity    Float            @default(0)
  /// `deliveredQuantity - rejectedQuantity`, computed and stored by `InventoryService`
  /// (never accepted from the client — brief §12: "Do not allow the user to manually
  /// enter Accepted Quantity"). This is the only figure that ever increases
  /// `InventoryStock`/writes an `InventoryTransaction` — see "Important Business Rule"
  /// in the brief.
  acceptedQuantity    Float
  rejectionReason     RejectionReason?
  rejectionNotes      String?
  createdAt           DateTime         @default(now())

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@map("goods_receipt_items")
}

/// The lightweight supplier-resolution state for a `GoodsReceipt`'s discrepancy (if any)
/// — Sprint 4.4.1 brief §5. Deliberately not a Supplier Claims/Returns/Credit-Note
/// system: this just preserves that a discrepancy happened and its current resolution
/// state, nothing more (no automated supplier notification, no financial claim, no
/// return logistics — all explicitly out of scope).
enum DiscrepancyStatus {
  NONE
  PENDING_SUPPLIER
  REPLACEMENT_EXPECTED
  REPLACEMENT_RECEIVED
  CREDIT_EXPECTED
  RESOLVED
}

/// The live stock balance — one row per (Organisation, Product, Location) as of Sprint
/// 4.5 (previously just (Organisation, Product) — see `InventoryLocation`), updated in
/// place as goods are received/adjusted (and, in future sprints, issued). Per the Sprint
/// 4.4 brief's "One Architectural Improvement": `InventoryTransaction` is the source of
/// truth/audit trail; this table is a fast-to-query cache of where that ledger currently
/// nets out, always re-derivable by summing this product's transactions at this
/// location.
model InventoryStock {
  id               String   @id @default(cuid())
  organisationId   String
  productId        String
  locationId       String
  quantityOnHand   Float    @default(0)
  /// Added Sprint 4.5, always `0` this sprint — no reservation workflow exists yet
  /// (brief §1: "Do not create reservation workflows in this sprint"). Kept as a real
  /// column now, not retrofitted later, so a future reservation feature (Sales order
  /// holds, Production batch allocation, ...) is an additive change, not another
  /// `InventoryStock` migration. `quantityAvailable` is never stored — always computed
  /// as `quantityOnHand - quantityReserved` at read time (`InventoryService`), and today
  /// that's simply `quantityOnHand`.
  quantityReserved Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location     InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, productId, locationId])
  @@index([organisationId])
  @@index([locationId])
  @@map("inventory_stock")
}

/// Sprint 4.4 only wrote `RECEIPT` rows (Goods Receiving); Sprint 4.5 added `ADJUSTMENT`
/// (controlled stock corrections). `ISSUE` (Production consumption, Sales) remains
/// reserved for future sprints — see docs/domains/inventory.md "Future Production
/// Consumption". Deliberately no generic manual "remove stock" action exists yet (brief
/// §3: "Do not create a generic 'remove stock' button that could bypass business
/// processes") — `ISSUE` will only ever be written by Production/Sales business logic,
/// not a standalone Inventory endpoint.
enum InventoryTransactionType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

/// Controlled reasons for an `ADJUSTMENT` transaction (Sprint 4.5 brief §5) — a simple
/// structured field plus free-text `InventoryTransaction.notes`, not an elaborate
/// configuration system.
enum AdjustmentReason {
  PHYSICAL_COUNT
  DAMAGE
  SPOILAGE
  LOSS
  FOUND_STOCK
  DATA_CORRECTION
  OTHER
}

/// The immutable stock ledger (Sprint 4.4 brief's "One Architectural Improvement") —
/// every inventory movement, ever, insert-only, never updated or deleted. Every future
/// domain that moves stock (Production, Sales, Stock Adjustment) is expected to write
/// here, the same way every domain already writes to `AuditLog` (identity.md §8).
model InventoryTransaction {
  id               String                   @id @default(cuid())
  organisationId   String
  productId        String
  /// Added Sprint 4.5 — which `InventoryStock` (Organisation, Product, Location) row
  /// this movement applied to.
  locationId       String
  transactionType  InventoryTransactionType
  /// Always positive — direction is carried by `transactionType`, not the sign of this
  /// column (a future `ISSUE` still records a positive quantity "removed"), keeping every
  /// row human-readable at a glance. The one exception: a negative `ADJUSTMENT` (a
  /// downward correction) *does* carry a negative sign, since "increase or decrease" is
  /// the adjustment's own point — see `InventoryService.adjustStock`.
  quantity         Float
  /// What business event produced this row (e.g. `"GoodsReceipt"`), paired with
  /// `referenceId` — same "polymorphic reference" shape as `AuditLog.entityType`/
  /// `entityId`, not a real FK (the referenced row may live in another domain's table).
  /// A manual `ADJUSTMENT` has no parent aggregate of its own, so `referenceType` is
  /// `"ManualAdjustment"` and `referenceId` is `null` — added Sprint 4.5, nullable only
  /// for that case.
  referenceType    String
  referenceId      String?
  /// Added Sprint 4.5 — set only on `ADJUSTMENT` rows, one of the controlled
  /// `AdjustmentReason` values (brief §5).
  adjustmentReason AdjustmentReason?
  /// Added Sprint 4.5 — free-text context, primarily for adjustments ("Physical count
  /// discrepancy during monthly stocktake").
  notes            String?
  /// Added Sprint 4.5 — who initiated this movement. Plain id, no FK relation, same
  /// convention as `AuditLog.actorUserId`/`GoodsReceipt.receivedById`. Always the
  /// authenticated caller.
  createdById      String?
  createdAt        DateTime                 @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location     InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([organisationId, productId])
  @@index([locationId])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

/// Sprint 4.6 (docs/domains/production.md) — DRAFT/ACTIVE/INACTIVE, not a numbered
/// version history: manufacturing formulas change over time, but rather than editing a
/// BOM in place, the convention is "create a new BillOfMaterial row, activate it,
/// deactivate the old one" — see `BillOfMaterialService.activate`. Exactly one `ACTIVE`
/// row should exist per finished product at a time (service-enforced, not a DB
/// constraint — same "Prisma has no native at-most-one-per-group constraint" situation
/// as `InventoryLocation.isDefault`).
enum BillOfMaterialStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// A recipe: how much of each raw material/packaging/consumable is required to produce
/// a defined yield of one finished product. Deliberately single-level — a component here
/// is never itself another `BillOfMaterial`'s finished product within this sprint's
/// scope (multi-level/sub-assembly BOMs are explicitly deferred).
model BillOfMaterial {
  id             String               @id @default(cuid())
  organisationId String
  /// Auto-generated (`BOM-000001`, ...), globally unique, immutable — same
  /// collision-avoidance pattern as `Product.code`/`PurchaseOrder.purchaseOrderNumber`/
  /// `GoodsReceipt.goodsReceiptNumber`. See `BillOfMaterialService.generateUniqueNumber`.
  bomNumber      String               @unique
  /// The finished product this recipe produces. Must be `ProductType.FINISHED_PRODUCT`
  /// — enforced in `BillOfMaterialService`, not the database, same convention as
  /// `PurchaseOrderService`'s product-type restriction on `PurchaseOrderItem`.
  productId      String
  /// Optional cosmetic label distinguishing multiple DRAFT/INACTIVE versions of the same
  /// product's recipe at a glance (e.g. "2026 Recipe"). Not the versioning mechanism
  /// itself — `status` + "create new, activate" is.
  name           String?
  status         BillOfMaterialStatus @default(DRAFT)
  /// The quantity of finished product this recipe yields, in the finished product's
  /// `unit` (e.g. `1000` when the product's unit is "Pack" — "this recipe is per 1,000
  /// packs"). Every `BillOfMaterialItem.quantity` is scoped to this amount; a Production
  /// Order's `ProductionOrderItem.requiredQuantity` is always
  /// `bomItem.quantity * plannedQuantity / yieldQuantity`. Must be positive.
  yieldQuantity  Float
  notes          String?
  /// Plain ids, no FK relation — same convention as every other domain's actor fields.
  createdById    String?
  updatedById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  items            BillOfMaterialItem[]
  productionOrders ProductionOrder[]

  @@index([organisationId])
  @@index([organisationId, productId])
  @@index([organisationId, productId, status])
  @@map("bill_of_materials")
}

/// One component line of a Bill of Materials — the quantity of a raw material/packaging/
/// consumable consumed per `billOfMaterial.yieldQuantity` of finished product.
model BillOfMaterialItem {
  id                 String   @id @default(cuid())
  billOfMaterialId   String
  /// Must be RAW_MATERIAL/PACKAGING_MATERIAL/CONSUMABLE — never FINISHED_PRODUCT —
  /// enforced in `BillOfMaterialService`, mirroring `PurchaseOrderService`'s identical
  /// component/purchasable-type restriction.
  componentProductId String
  /// Quantity of this component consumed per `billOfMaterial.yieldQuantity` of finished
  /// product. Must be positive.
  quantity           Float
  /// Free text (same convention as `Product.unit`) — typically matches the component
  /// product's own `unit`, but stored independently since a recipe may reasonably express
  /// a quantity in a different unit than the product's stock-tracking unit. No unit
  /// conversion is performed anywhere in this domain (see docs/domains/production.md
  /// "Known Limitations").
  unitOfMeasure      String
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  billOfMaterial   BillOfMaterial @relation(fields: [billOfMaterialId], references: [id], onDelete: Cascade)
  componentProduct Product        @relation(fields: [componentProductId], references: [id], onDelete: Restrict)

  /// DB-level defense-in-depth for "duplicate component lines prevented" (the Zod schema
  /// also rejects duplicates at create/update time — this catches any path that bypasses
  /// it).
  @@unique([billOfMaterialId, componentProductId])
  @@index([billOfMaterialId])
  @@index([componentProductId])
  @@map("bill_of_material_items")
}

/// DRAFT -> PLANNED -> IN_PROGRESS -> COMPLETED. `IN_PROGRESS` is entered only as a side
/// effect of the first successful Material Issue against the order (no separate manual
/// "Start" action) — see `ProductionMaterialIssueRepository.issue`. `CANCELLED` is only
/// reachable from DRAFT/PLANNED: once material has been issued (i.e. once IN_PROGRESS),
/// cancellation is deliberately blocked rather than triggering a silent inventory
/// reversal — see docs/domains/production.md "Known Limitations".
enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// An instruction to manufacture a defined quantity of a finished product, against one
/// specific (pinned) Bill of Materials version. Sprint 4.6 (docs/domains/production.md).
model ProductionOrder {
  id                    String                @id @default(cuid())
  organisationId        String
  /// Auto-generated (`PROD-000001`, ...), globally unique, immutable. `PO-` is already
  /// `PurchaseOrder.purchaseOrderNumber`'s prefix, hence `PROD-` here.
  productionOrderNumber String                @unique
  /// Denormalised from `billOfMaterial.productId` at creation time — the finished
  /// product being manufactured. Never re-derived later; storing it directly avoids
  /// every read joining through `billOfMaterial` just to know the product.
  productId             String
  /// The specific BOM version used, pinned at creation and never changed afterward — a
  /// Bill of Materials is itself never edited in place once used (see
  /// `BillOfMaterialService.update`'s DRAFT-only restriction), and the actual material
  /// requirement snapshot lives on `ProductionOrderItem` below, so this reference alone
  /// is enough to guarantee a later BOM edit can never retroactively change this order.
  billOfMaterialId      String
  /// The quantity of finished product this order intends to produce.
  plannedQuantity       Float
  /// The physical location this order consumes materials from and receives finished
  /// goods into. Reuses `InventoryLocation` — no separate warehouse concept.
  locationId            String
  status                ProductionOrderStatus @default(DRAFT)
  notes                 String?
  createdById           String?
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product        Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  billOfMaterial BillOfMaterial            @relation(fields: [billOfMaterialId], references: [id], onDelete: Restrict)
  location       InventoryLocation         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items          ProductionOrderItem[]
  materialIssues ProductionMaterialIssue[]
  productionRun  ProductionRun?

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, productId])
  @@index([billOfMaterialId])
  @@index([locationId])
  @@map("production_orders")
}

/// The immutable material-requirement snapshot for one Production Order — one row per
/// BOM component, `requiredQuantity` computed exactly once at order-creation time
/// (`bomItem.quantity * plannedQuantity / billOfMaterial.yieldQuantity`) and never
/// recalculated afterward, even if the source Bill of Materials is later edited,
/// deactivated, or superseded. This is what guarantees "later BOM changes must never
/// retroactively change an existing Production Order's material requirements." Issued/
/// remaining quantities are deliberately NOT stored here — always derived by summing
/// `ProductionMaterialIssueItem` rows at read time (mirrors
/// `GoodsReceiptRepository.getReceivingTotals`'s `groupBy` pattern, rather than a
/// redundant running-total column that could drift).
model ProductionOrderItem {
  id                 String   @id @default(cuid())
  productionOrderId  String
  componentProductId String
  requiredQuantity   Float
  /// Copied from `BillOfMaterialItem.unitOfMeasure` at creation time — same
  /// point-in-time-snapshot rationale as `requiredQuantity`.
  unitOfMeasure      String
  createdAt          DateTime @default(now())

  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation(fields: [componentProductId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
  @@index([componentProductId])
  @@map("production_order_items")
}

/// One batch material-issue event against a Production Order — immutable once created,
/// same "header + item rows, paired 1:1 with `InventoryTransaction` rows" shape as
/// `GoodsReceipt`/`GoodsReceiptItem`. A Production Order may have many of these, to
/// support partial/multiple issues over time (brief §14).
model ProductionMaterialIssue {
  id                String   @id @default(cuid())
  organisationId    String
  productionOrderId String
  issuedDate        DateTime
  /// Plain id, no FK relation, same convention as `GoodsReceipt.receivedById`. Always
  /// the authenticated caller.
  issuedById        String?
  notes             String?
  createdAt         DateTime @default(now())

  organisation    Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder               @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  items           ProductionMaterialIssueItem[]

  @@index([organisationId])
  @@index([organisationId, productionOrderId])
  @@map("production_material_issues")
}

/// One component's issued quantity within a `ProductionMaterialIssue` batch. Pairs 1:1
/// with an `InventoryTransaction` `ISSUE` row (`referenceType: 'ProductionMaterialIssue'`,
/// `referenceId: this issue's id`) — exact mirror of `GoodsReceiptItem` -> `RECEIPT`.
model ProductionMaterialIssueItem {
  id                        String   @id @default(cuid())
  productionMaterialIssueId String
  componentProductId        String
  quantityIssued            Float
  createdAt                 DateTime @default(now())

  productionMaterialIssue ProductionMaterialIssue @relation(fields: [productionMaterialIssueId], references: [id], onDelete: Cascade)
  componentProduct        Product                 @relation(fields: [componentProductId], references: [id], onDelete: Restrict)

  @@index([productionMaterialIssueId])
  @@index([componentProductId])
  @@map("production_material_issue_items")
}

/// Controlled reasons for rejected production output (brief §17) — a simple structured
/// field plus free-text `ProductionRun.rejectionNotes`, not a full Quality Management
/// System.
enum ProductionRejectionReason {
  BURNT
  UNDERWEIGHT
  PACKAGING_DEFECT
  POOR_SEAL
  OTHER
}

/// The completion event for a Production Order — MVP: at most one per order (enforced by
/// the `@@unique` below), kept as its own immutable table (not columns on
/// `ProductionOrder`) for the same reason `GoodsReceipt` is its own table rather than
/// columns on `PurchaseOrder`: an event record, paired with the `InventoryTransaction`
/// `RECEIPT` row it produces, not a mutable running total. `acceptedQuantity` is always
/// server-computed as `producedQuantity - rejectedQuantity` (brief: never trust the
/// client) — only the accepted portion ever enters `InventoryStock`; rejected output does
/// not.
model ProductionRun {
  id                String                     @id @default(cuid())
  organisationId    String
  productionOrderId String                     @unique
  producedQuantity  Float
  rejectedQuantity  Float                      @default(0)
  acceptedQuantity  Float
  rejectionReason   ProductionRejectionReason?
  rejectionNotes    String?
  /// Plain id, no FK relation, same convention as every other domain's actor fields.
  completedById     String?
  completedAt       DateTime                   @default(now())

  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("production_runs")
}

// ============================================================================
// Sprint 4.8 — Customer, Territory, Outlet, Retail Network & Sales Foundation
// (docs/domains/customers.md, outlets.md, territories.md, retail-network.md, sales.md)
//
// CORE PRINCIPLE: CAPTURE THE MARKET FIRST, STRUCTURE THE NETWORK PROGRESSIVELY.
// A Customer never requires a distributor/territory/outlet mapping to be registered or
// to place an order. `DistributionNetworkRelationship` is a separate, always-optional
// concept from `SalesOrder` — no code path in this schema or the domain that consumes it
// ever lets a network relationship gate or rewrite a commercial transaction.
// ============================================================================

/// Purely descriptive market intelligence — NEVER a sales restriction. No code anywhere
/// in this codebase branches on `customerType` to decide whether a customer may place an
/// order; a Distributor, Wholesaler, Retailer, and Supermarket can all buy directly from
/// the organisation. Not modelled as mutually-exclusive-forever — correctable any time via
/// `PATCH`.
enum CustomerType {
  DISTRIBUTOR
  WHOLESALER
  RETAILER
  SUPERMARKET
  CORPORATE
  INSTITUTION
  RESTAURANT
  HOTEL
  OTHER
}

/// ACTIVE/INACTIVE only — same "usable vs. retired, never physically deleted" shape as
/// `SupplierStatus`/`LocationStatus`/`ProductFamilyStatus`.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

/// Deliberately extensible: no business logic anywhere is keyed on a specific member of
/// this enum, so adding a new outlet type later is a pure additive migration.
enum OutletType {
  SUPERMARKET
  HYPERMARKET
  WHOLESALE_STORE
  RETAIL_SHOP
  KIOSK
  MARKET_STALL
  DISTRIBUTOR_WAREHOUSE
  WHOLESALER_WAREHOUSE
  CONVENIENCE_STORE
  RESTAURANT
  HOTEL
  CORPORATE
  INSTITUTION
  OTHER
}

enum OutletStatus {
  ACTIVE
  INACTIVE
}

enum TerritoryStatus {
  ACTIVE
  INACTIVE
}

/// An optional descriptive label for what an outlet photo shows. No AI/image analysis
/// anywhere — this enum exists purely so the Admin/Field UI can group photos sensibly.
enum OutletPhotoType {
  FRONT
  SIGNAGE
  INTERIOR
  SHELF_DISPLAY
  OTHER
}

/// How the source customer relates to the target customer in the distribution network —
/// a map of the market, never a prerequisite for a `SalesOrder`.
enum DistributionRelationshipType {
  DISTRIBUTES_TO
  WHOLESALES_TO
  SUPPLIES
  OTHER
}

enum NetworkRelationshipStatus {
  ACTIVE
  INACTIVE
}

/// DRAFT -> CONFIRMED -> PARTIALLY_FULFILLED -> FULFILLED, or -> CANCELLED from DRAFT or
/// CONFIRMED only (Sprint 4.9). Confirming a Sales Order still never deducts or reserves
/// inventory — it records demand only. `PARTIALLY_FULFILLED`/`FULFILLED` are driven
/// exclusively by `SalesFulfilment` records, the ONE place inventory is actually deducted
/// (docs/domains/sales.md "Fulfilment"). Once any fulfilment has been recorded, an order
/// can no longer be cancelled (`SalesOrderService.cancel`) — reversing partially-shipped
/// goods is out of scope this sprint (see docs/backlog.md "Sales Returns").
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

/// A self-referential, organisation-defined hierarchy of arbitrary depth (e.g. Oyo State
/// -> Ibadan -> Ibadan North -> Bodija). Deliberately NOT modelled on Nigerian
/// administrative boundaries or any fixed level count: `type` is free text (same
/// convention as `Product.unit`) so one tenant can use State/City/LGA/Area and another
/// Region/Zone/Route without a migration. No GIS, polygons, geofencing, or route
/// optimisation — this is a naming tree, nothing more.
model Territory {
  id                String          @id @default(cuid())
  organisationId    String
  /// Auto-generated (`TER-000001`, ...), globally unique, immutable.
  territoryCode     String          @unique
  name              String
  /// Free text, e.g. "State", "City", "LGA", "Area" — tenant-defined, no fixed levels.
  type              String
  /// `null` for a root territory. Self-referential; depth is unbounded (service-enforced
  /// cycle guard, since a self-referential FK cannot express "no cycles" declaratively).
  parentTerritoryId String?
  status            TerritoryStatus @default(ACTIVE)
  description       String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `SetNull` (not `Restrict`) for the same reason as `Product.productVariantId`: an
  /// optional grouping pointer must never block or cascade the child row it labels. No
  /// delete endpoint exists for territories anyway (deactivate-only convention).
  parentTerritory  Territory?   @relation("TerritoryHierarchy", fields: [parentTerritoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  childTerritories Territory[]  @relation("TerritoryHierarchy")
  customers        Customer[]
  outlets          Outlet[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([parentTerritoryId])
  @@map("territories")
}

/// The COMMERCIAL ACCOUNT: who the organisation bills and sells to. Distinct from
/// `Outlet` (the physical place of business) — a customer may have zero, one, or many
/// outlets, and zero is a fully valid steady state (e.g. a corporate account with no
/// storefront, or a customer just onboarded).
///
/// Only `customerType`, `customerName`, and `phoneNumber` are required — everything else
/// (territory, contact person, email, address, notes) is optional and addable later, so a
/// field agent can register a market trader in under two minutes. There is deliberately
/// NO `distributorId`/`parentCustomerId` column: distribution network structure lives in
/// `DistributionNetworkRelationship`, a separate, always-optional entity that the Sales
/// domain never consults.
model Customer {
  id                   String         @id @default(cuid())
  organisationId       String
  /// Auto-generated (`CUS-000001`, ...), globally unique, immutable.
  customerCode         String         @unique
  customerType         CustomerType
  /// The business name for a registered company, or simply the trader's/shop's name for
  /// an informal retailer — one column deliberately, since this model must not assume
  /// every customer is a formal company. Named after `Supplier.supplierName`, its closest
  /// sibling entity.
  customerName         String
  contactPersonName    String?
  /// The one contact detail that is always required — a field agent can always get a
  /// phone number, even from a market stall with no address or registration number.
  phoneNumber          String
  alternatePhoneNumber String?
  email                String?
  address              String?
  city                 String?
  state                String?
  country              String?
  /// Optional at onboarding and changeable later — never required to register a customer
  /// or place an order.
  territoryId          String?
  status               CustomerStatus @default(ACTIVE)
  notes                String?
  createdById          String?
  updatedById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organisation                 Organisation                      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `SetNull` — an optional grouping label; deactivating or restructuring a territory
  /// must never block or orphan a commercial account.
  territory                    Territory?                        @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  outlets                      Outlet[]
  salesOrders                  SalesOrder[]
  /// The distribution network map, both directions. Always optional; a customer with zero
  /// rows in either relation buys directly and is fully first-class.
  networkRelationshipsAsSource DistributionNetworkRelationship[] @relation("NetworkSource")
  networkRelationshipsAsTarget DistributionNetworkRelationship[] @relation("NetworkTarget")
  /// Added Sprint 5 — Distribution & Delivery (docs/domains/distribution.md).
  dispatches                   Dispatch[]
  /// Added Sprint 6 — Finance (docs/domains/finance.md).
  invoices                     Invoice[]
  payments                     Payment[]
  creditNotes                  CreditNote[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, customerType])
  @@index([territoryId])
  @@map("customers")
}

/// A PHYSICAL PLACE OF BUSINESS belonging to one commercial account. Customer != Outlet:
/// a corporate customer may have none, a supermarket chain many. Creating a customer never
/// requires creating an outlet.
///
/// `latitude`/`longitude` are optional, captured once from browser geolocation at outlet
/// creation if the agent grants permission. There is NO continuous tracking, no
/// `watchPosition`, no geofencing, and no route optimisation anywhere in this codebase.
model Outlet {
  id                String       @id @default(cuid())
  organisationId    String
  customerId        String
  /// Auto-generated (`OUT-000001`, ...), globally unique, immutable.
  outletCode        String       @unique
  outletType        OutletType
  name              String
  contactPersonName String?
  phoneNumber       String?
  address           String?
  city              String?
  state             String?
  country           String?
  territoryId       String?
  latitude          Float?
  longitude         Float?
  status            OutletStatus @default(ACTIVE)
  notes             String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `Restrict` — an internal domain FK with no delete endpoint on either side, same
  /// default as `ProductVariant.productFamilyId`. An outlet belongs to exactly one
  /// customer; `customerId` is immutable on update (service-enforced) since moving it
  /// would rewrite sales-order attribution.
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  territory    Territory?    @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  photos       OutletPhoto[]
  salesOrders  SalesOrder[]
  /// Added Sprint 5 — Distribution & Delivery (docs/domains/distribution.md).
  dispatches   Dispatch[]
  /// Added Sprint 6 — Finance (docs/domains/finance.md).
  invoices     Invoice[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, customerId])
  @@index([territoryId])
  @@map("outlets")
}

/// One uploaded photo of one outlet — the first multi-file-per-entity model in this
/// codebase. `Product.imageUrl`/`imageKey`, `Organisation.logoUrl`, and
/// `User.avatarUrl`/`avatarKey` are all single-file columns on the owning row, which
/// cannot express "front, signage, interior, shelf display". The `FileStorage` port
/// itself is deliberately UNCHANGED — `OutletService` calls the existing `upload()` once
/// per file and writes one row here per result, so a future S3 adapter still only
/// implements the same two methods.
///
/// Foundational capture/store/associate only — no AI, no image recognition, no analytics.
model OutletPhoto {
  id             String           @id @default(cuid())
  /// Carried explicitly (rather than joined through `outlet`) so every read/delete can be
  /// tenant-scoped in a single query — same denormalisation rationale as
  /// `GoodsReceipt.supplierId`.
  organisationId String
  outletId       String
  /// Absolute URL from `FileStorage.upload` — ready to use as an `<img src>`.
  url            String
  /// Opaque storage key, needed to `FileStorage.delete` this exact file on removal.
  key            String
  photoType      OutletPhotoType?
  caption        String?
  createdById    String?
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `Cascade` — a true child of the Outlet aggregate with no independent meaning, same as
  /// `BillOfMaterialItem`/`SalesOrderItem`.
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([outletId])
  @@map("outlet_photos")
}

/// THE critical architectural piece. `sourceCustomer --[relationshipType]--> targetCustomer`
/// describes how goods move through the market AFTER leaving the organisation. It is a
/// separate, entirely optional concept from commercial transactions:
///
///   - A direct sale from the organisation to a Retailer is a `SalesOrder`, NOT a
///     relationship. It needs no row here at all.
///   - No code path anywhere validates "does this customer have a distributor" before
///     allowing an order. The Sales module does not import the Network module, so it
///     structurally cannot.
///   - Adding, changing, or deactivating a relationship NEVER rewrites, re-parents, or
///     recalculates any historical `SalesOrder`. `SalesOrder` has no FK to this table.
///
/// `effectiveFrom`/`effectiveTo` preserve the history of a relationship rather than editing
/// it away, so a lapsed relationship can be re-established later as a new row — which is
/// why there is deliberately NO `@@unique` on (source, target, type): the service rejects
/// a duplicate *ACTIVE* pair, a database constraint would forbid the legitimate historical
/// one.
model DistributionNetworkRelationship {
  id               String                       @id @default(cuid())
  organisationId   String
  sourceCustomerId String
  targetCustomerId String
  relationshipType DistributionRelationshipType
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  status           NetworkRelationshipStatus    @default(ACTIVE)
  notes            String?
  createdById      String?
  updatedById      String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `Restrict` on both sides — a relationship is a historical record; neither endpoint
  /// may be removed out from under it.
  sourceCustomer Customer     @relation("NetworkSource", fields: [sourceCustomerId], references: [id], onDelete: Restrict)
  targetCustomer Customer     @relation("NetworkTarget", fields: [targetCustomerId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([sourceCustomerId])
  @@index([targetCustomerId])
  @@map("distribution_network_relationships")
}

/// A record of DEMAND: "this customer ordered this much of these SKUs." Creating or
/// confirming one NEVER deducts, reserves, or otherwise touches
/// `InventoryStock`/`InventoryTransaction` — stock availability may be shown while
/// building an order, but only as a live informational read of the existing
/// `GET /api/inventory/:productId` endpoint, exactly like Production's Material
/// Availability Check, and it never gates anything.
///
/// `outletId` is optional: a corporate account with no storefront, or a customer whose
/// outlets haven't been mapped yet, can still order. When supplied it MUST belong to the
/// same customer (service-enforced) — see docs/domains/sales.md "Outlet Attribution".
model SalesOrder {
  id             String           @id @default(cuid())
  organisationId String
  /// Auto-generated (`SO-000001`, ...), globally unique, immutable. `PO-` is already
  /// `PurchaseOrder`'s prefix, hence `SO-` here.
  orderCode      String           @unique
  customerId     String
  outletId       String?
  /// The user who took the order. Plain id, no FK relation — same convention as
  /// `GoodsReceipt.receivedById`/`ProductionMaterialIssue.issuedById`. Always the
  /// authenticated caller, never accepted as free-text input.
  salesAgentId   String
  status         SalesOrderStatus @default(DRAFT)
  orderDate      DateTime
  notes          String?
  /// All three are server-calculated and never trusted from the client — same rule as
  /// `PurchaseOrderService`'s totals and `ProductionRun.acceptedQuantity`.
  subtotal       Float
  /// An order-level discount amount (not a percentage, not per-line). Client-supplied but
  /// validated `0 <= discount <= subtotal` server-side. No tax in this sprint.
  discount       Float            @default(0)
  /// `subtotal - discount`, computed server-side.
  total          Float
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `Restrict` on both — a sales order is history and must never be silently re-pointed
  /// or null-ed out. `outletId` is optional but deliberately declared `Restrict` rather
  /// than letting it default to `SetNull`, which would rewrite history.
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  outlet       Outlet?          @relation(fields: [outletId], references: [id], onDelete: Restrict)
  items        SalesOrderItem[]
  fulfilments  SalesFulfilment[]
  /// Added Sprint 5 — Distribution & Delivery (docs/domains/distribution.md). Denormalised
  /// inverse of `Dispatch.salesOrderId`.
  dispatches   Dispatch[]
  /// Added Sprint 6 — Finance (docs/domains/finance.md). Denormalised inverse of
  /// `Invoice.salesOrderId`.
  invoices     Invoice[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, customerId])
  @@index([organisationId, orderDate])
  @@index([outletId])
  @@map("sales_orders")
}

/// One line of a Sales Order. `productId` must reference a SKU-level `Product` whose
/// `type` is `FINISHED_PRODUCT` — never a `ProductFamily` or `ProductVariant`, which are
/// grouping labels and were never transactional targets. Enforced in
/// `SalesOrderService.buildItems`, mirroring `PurchaseOrderService`'s identical
/// purchasable-type restriction.
model SalesOrderItem {
  id                String   @id @default(cuid())
  salesOrderId      String
  productId         String
  quantity          Float
  /// Cumulative quantity physically supplied across every `SalesFulfilmentItem` ever
  /// recorded against this line (Sprint 4.9) — never decremented, only ever incremented
  /// by `SalesFulfilmentRepository.create`'s own transaction. Always
  /// `0 <= quantityFulfilled <= quantity` (service-enforced; over-fulfilment is a 400).
  /// Drives `SalesOrder.status` derivation — see docs/domains/sales.md "Fulfilment".
  quantityFulfilled Float    @default(0)
  unitPrice         Float
  /// Server-calculated as `roundCurrency(quantity * unitPrice)` — deliberately absent from
  /// `salesOrderItemInputSchema` so the client cannot even express a value.
  lineTotal         Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salesOrder      SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  fulfilmentItems SalesFulfilmentItem[]
  /// Added Sprint 6 — Finance (docs/domains/finance.md).
  invoiceItems    InvoiceItem[]

  /// DB-level defense-in-depth for "no duplicate SKU lines" (the Zod schema also rejects
  /// duplicates) — same shape as `BillOfMaterialItem`'s own `@@unique`.
  @@unique([salesOrderId, productId])
  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

/// One physical-supply event against a Sales Order — immutable once created, same
/// "header + item rows, paired 1:1 with `InventoryTransaction` rows" shape as
/// `ProductionMaterialIssue`. A Sales Order may have many of these over time (partial
/// shipments), same as Production's material issues (Sprint 4.9, docs/domains/sales.md
/// "Fulfilment"). THE only place a Sales Order's inventory is ever deducted.
model SalesFulfilment {
  id             String   @id @default(cuid())
  organisationId String
  salesOrderId   String
  /// The `InventoryLocation` every item in this batch was deducted from — one location
  /// per fulfilment event, same "one location per batch" shape as
  /// `ProductionMaterialIssue`/`GoodsReceipt`. Multi-location fulfilment of a single order
  /// is out of scope this sprint (docs/backlog.md).
  locationId     String
  fulfilmentDate DateTime
  /// Plain id, no FK relation — same convention as `ProductionMaterialIssue.issuedById`.
  /// Always the authenticated caller.
  fulfilledById  String?
  notes          String?
  /// Client-supplied, optional. When present, a retried request (double-tap, flaky
  /// mobile network) with the SAME key against the SAME order returns the original
  /// `SalesFulfilment` instead of creating a duplicate. A practical, database-backed
  /// dedup key (not a distributed idempotency system) — same spirit as
  /// `ProductionRun.productionOrderId`'s `@@unique` being the only other hard
  /// duplicate-protection constraint in this codebase. Postgres treats every `NULL` as
  /// distinct, so a caller that never sends a key is never blocked.
  idempotencyKey String?
  createdAt      DateTime @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `Restrict`, not `Cascade` — a fulfilment is history and must survive even if a
  /// future feature ever allowed deleting a Sales Order (it doesn't today), same
  /// rationale as `ProductionMaterialIssue.productionOrder`.
  salesOrder   SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  /// `Restrict` — same rationale as every other `InventoryLocation` FK: a location that
  /// has been used in a real stock movement can never be silently deleted out from under
  /// history.
  location     InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items        SalesFulfilmentItem[]
  /// Added Sprint 5 — Distribution & Delivery (docs/domains/distribution.md).
  dispatches   Dispatch[]

  @@unique([salesOrderId, idempotencyKey])
  @@index([organisationId])
  @@index([organisationId, salesOrderId])
  @@map("sales_fulfilments")
}

/// One product's fulfilled quantity within a `SalesFulfilment` batch. Pairs 1:1 with an
/// `InventoryTransaction` `ISSUE` row (`referenceType: 'SalesFulfilment'`, `referenceId:`
/// this fulfilment's id) — exact mirror of `ProductionMaterialIssueItem` -> `ISSUE`.
model SalesFulfilmentItem {
  id                String   @id @default(cuid())
  salesFulfilmentId String
  productId         String
  /// The `SalesOrderItem` this fulfils — needed to atomically increment that line's own
  /// `quantityFulfilled` inside the same transaction.
  salesOrderItemId  String
  quantityFulfilled Float
  /// Added Sprint 5 — cumulative quantity released across every `DispatchItem` ever
  /// created against this line (via `DispatchItem.salesFulfilmentItemId`). Never
  /// decremented, only incremented inside `DispatchRepository.create`'s own
  /// transaction. Always `0 <= quantityDispatched <= quantityFulfilled`
  /// (service-enforced). Mirrors `SalesOrderItem.quantityFulfilled`'s own
  /// cumulative-progress convention one level further down the chain — see
  /// docs/domains/distribution.md.
  quantityDispatched Float    @default(0)
  createdAt         DateTime @default(now())

  salesFulfilment SalesFulfilment @relation(fields: [salesFulfilmentId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrderItem  SalesOrderItem  @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  /// Added Sprint 5 (docs/domains/distribution.md).
  dispatchItems   DispatchItem[]

  @@index([salesFulfilmentId])
  @@index([productId])
  @@index([salesOrderItemId])
  @@map("sales_fulfilment_items")
}

// ============================================================================
// Sprint 5 — Distribution & Delivery Operations Foundation
// (docs/domains/distribution.md)
//
// CORE PRINCIPLE: Sales Fulfilment (Sprint 4.9) remains the ONE place inventory is
// ever deducted. Dispatch and Delivery are purely operational records about the
// movement of already-fulfilled stock — neither ever touches `InventoryStock` or
// `InventoryTransaction`. Distribution Network relationships remain purely
// informational/contextual, never a gate on dispatch or delivery.
// ============================================================================

/// `READY` (created, not yet physically released) -> `DISPATCHED` (left the source
/// location) -> `IN_TRANSIT` (optional intermediate) -> `PARTIALLY_DELIVERED`/
/// `DELIVERED` (driven exclusively by `Delivery` records, never set directly). `CANCELLED`
/// is reachable from `READY`/`DISPATCHED`/`IN_TRANSIT` only, blocked once any delivery
/// exists. `FAILED` is reachable from `DISPATCHED`/`IN_TRANSIT` only ("goods dispatched
/// but the customer could not receive them"). Both `CANCELLED` and `FAILED` are terminal.
enum DispatchStatus {
  READY
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  FAILED
}

/// A batch of already-fulfilled goods physically released toward a destination
/// (Sprint 5, docs/domains/distribution.md). Never touches `InventoryStock`/
/// `InventoryTransaction` — Sales Fulfilment remains the sole inventory-deduction
/// event. `status` is derived from `DispatchItem.quantityDelivered` vs
/// `quantityDispatched` after every `Delivery`, never independently set except by the
/// plain lifecycle transitions (`dispatch`/`in-transit`/`cancel`/`fail`).
model Dispatch {
  id                String         @id @default(cuid())
  organisationId    String
  /// Auto-generated (`DSP-000001`, ...), globally unique, immutable — same
  /// collision-avoidance loop as `SO-`/`OUT-`/`CUS-`.
  dispatchCode      String         @unique
  salesFulfilmentId String
  /// Denormalised from `salesFulfilment.salesOrderId` at creation time — lets
  /// `GET /distribution?salesOrderId=` filter with one query instead of joining
  /// through `SalesFulfilment`, same denormalisation rationale as
  /// `OutletPhoto.organisationId`.
  salesOrderId      String
  customerId        String
  /// Optional; defaults from the Sales Order's own `outletId` at creation time but may
  /// be overridden — when supplied it must belong to the same `customerId`
  /// (service-enforced, same check as `SalesOrderService.assertOutletBelongsToCustomer`).
  outletId          String?
  /// The `InventoryLocation` goods physically left from — read-only display context,
  /// never a second inventory-deduction point.
  sourceLocationId  String
  dispatchDate      DateTime
  status            DispatchStatus @default(READY)
  notes             String?
  /// Client-supplied, optional. A retried "create dispatch" request (double-tap, flaky
  /// mobile network) with the SAME key against the SAME fulfilment returns the
  /// original `Dispatch` instead of creating a duplicate — same convention as
  /// `SalesFulfilment.idempotencyKey`.
  idempotencyKey    String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `Restrict` — a dispatch is history and must survive even if a future feature ever
  /// allowed deleting a Sales Fulfilment (it doesn't today), same rationale as
  /// `SalesFulfilment.salesOrder`.
  salesFulfilment SalesFulfilment   @relation(fields: [salesFulfilmentId], references: [id], onDelete: Restrict)
  /// `Restrict` — denormalised pointer, same immutability guarantee as the FK it
  /// duplicates.
  salesOrder      SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  /// `Restrict` — a dispatch is history; a customer record must never be silently
  /// re-pointed or null-ed out from under it (same rule as `SalesOrder.customer`).
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// `Restrict`, nullable — optional but, once set, must survive (same "optional but
  /// Restrict, not SetNull" rule `SalesOrder.outlet` already uses).
  outlet          Outlet?           @relation(fields: [outletId], references: [id], onDelete: Restrict)
  /// `Restrict` — same rationale as every other `InventoryLocation` FK in this codebase.
  sourceLocation  InventoryLocation @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  items           DispatchItem[]
  deliveries      Delivery[]

  @@unique([salesFulfilmentId, idempotencyKey])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, salesOrderId])
  @@index([organisationId, customerId])
  @@map("dispatches")
}

/// One line of a Dispatch. No `@@unique([dispatchId, productId])` — a single Dispatch
/// may legitimately draw the same product from two different `SalesFulfilmentItem`
/// batches; duplicate-line prevention is Zod-only (`hasNoDuplicateDispatchItems`, keyed
/// on `salesFulfilmentItemId`), same precedent `SalesFulfilmentItem` itself already
/// sets (no DB-level unique there either).
model DispatchItem {
  id                    String   @id @default(cuid())
  dispatchId            String
  productId             String
  /// The specific `SalesFulfilmentItem` this dispatch line releases — needed to
  /// atomically increment that line's own `quantityDispatched` inside the same
  /// transaction, and gives precise per-line traceability back to which fulfilment
  /// batch's stock this dispatch line came from.
  salesFulfilmentItemId String
  quantityDispatched    Float
  /// Cumulative quantity confirmed received across every `DeliveryItem` ever recorded
  /// against this line. Never decremented, only incremented inside
  /// `DeliveryRepository.create`'s own transaction. Always
  /// `0 <= quantityDelivered <= quantityDispatched`. Drives `Dispatch.status`
  /// derivation — see docs/domains/distribution.md "Status Derivation".
  quantityDelivered     Float    @default(0)
  createdAt             DateTime @default(now())

  dispatch            Dispatch            @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesFulfilmentItem SalesFulfilmentItem @relation(fields: [salesFulfilmentItemId], references: [id], onDelete: Restrict)
  deliveryItems       DeliveryItem[]

  @@index([dispatchId])
  @@index([productId])
  @@index([salesFulfilmentItemId])
  @@map("dispatch_items")
}

/// One delivery-confirmation event against a Dispatch — immutable once created (except
/// the two photo columns, populated by a separate follow-up request after the row
/// already exists). Multiple allowed per Dispatch (partial-then-remainder), same "many
/// child events over time" shape as `SalesFulfilment` against a `SalesOrder`.
model Delivery {
  id             String   @id @default(cuid())
  organisationId String
  dispatchId     String
  deliveryDate   DateTime
  /// Free text — who at the destination signed for / accepted the goods. Not a FK: the
  /// recipient is very often not a system user (a shopkeeper, a security guard, ...).
  receivedByName String?
  /// Captures WHY there's a shortfall (damaged/lost/refused/etc.) for this sprint's
  /// minimal auditable-foundation requirement — no reason-code enum, no Returns
  /// workflow (docs/backlog.md "Deferred").
  notes          String?
  /// Populated by a separate follow-up `POST /distribution/deliveries/:id/photo`
  /// request AFTER this row exists — same "single nullable scalar pair, not a
  /// child-table" precedent as `Product.imageUrl`/`imageKey`, deliberately not
  /// `OutletPhoto`'s multi-photo child-table shape since exactly one proof-of-delivery
  /// photo is ever needed here.
  photoUrl       String?
  photoKey       String?
  /// Client-supplied, optional. Same idempotency convention as
  /// `SalesFulfilment.idempotencyKey`/`Dispatch.idempotencyKey`.
  idempotencyKey String?
  /// Plain id, no FK relation — same convention as `SalesFulfilment.fulfilledById`.
  createdById    String?
  createdAt      DateTime @default(now())

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// `Restrict` — a delivery is history and must survive even if a future feature ever
  /// allowed deleting a Dispatch (it doesn't today).
  dispatch     Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  items        DeliveryItem[]

  @@unique([dispatchId, idempotencyKey])
  @@index([organisationId])
  @@index([organisationId, dispatchId])
  @@map("deliveries")
}

/// One product's delivered quantity within a `Delivery` batch.
model DeliveryItem {
  id                String   @id @default(cuid())
  deliveryId        String
  productId         String
  /// The `DispatchItem` this delivery confirms receipt against — needed to atomically
  /// increment that line's own `quantityDelivered` inside the same transaction.
  dispatchItemId    String
  quantityDelivered Float
  createdAt         DateTime @default(now())

  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  dispatchItem DispatchItem @relation(fields: [dispatchItemId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@index([productId])
  @@index([dispatchItemId])
  @@map("delivery_items")
}

// ============================================================================
// Finance (Sprint 6, docs/domains/finance.md) — Invoices, Payments, Credit
// Notes, Accounts Receivable. Deliberately NOT a General Ledger/Chart of
// Accounts/accounting system — see docs/domains/finance.md "Deferred
// Accounting Work". Finance reads Sales Order data read-only (via
// SalesModule's exported SalesOrderRepository) and never writes to
// SalesOrder/Dispatch/Delivery/InventoryStock — proven by
// finance-independence.spec.ts, not just documented here.
// ============================================================================

/// Determines an Invoice's due date, server-computed from `invoiceDate` at
/// creation time. A fixed enum (not a lookup table) — same convention as
/// `DispatchStatus`/`CustomerType`; a genuinely tenant-configurable Payment
/// Terms table is deferred future work, not needed for this sprint's fixed
/// set of terms.
enum PaymentTermType {
  CASH
  DUE_ON_RECEIPT
  NET_7
  NET_14
  NET_30
}

/// `DRAFT → ISSUED → {PARTIALLY_PAID → PAID}`, with `VOID` (from `DRAFT`
/// freely, or from `ISSUED` only while nothing has been paid/credited yet)
/// and `OVERDUE` (a lazy, read-time sweep — see `InvoiceRepository`'s doc
/// comment — since this codebase has no cron/scheduler infrastructure) as
/// side-branches. Never mutated arbitrarily; every transition is a named,
/// guarded repository method.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  OTHER
}

/// `VOIDED` is a corrective reversal, never a delete — see `Payment`'s own
/// doc comment.
enum PaymentStatus {
  RECORDED
  VOIDED
}

/// `DRAFT → ISSUED` (applies the credit to its invoice) `→ VOID` (reverses
/// it). Mirrors `InvoiceStatus`'s own DRAFT/ISSUED split.
enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

/// The financial consequence of a fulfilled Sales Order — created explicitly
/// by Finance, never automatically on order creation/confirmation (brief's
/// own "Critical Architectural Rule"). `salesOrderId` is nullable at the
/// schema level (a future non-order invoice path is conceivable) but
/// `InvoiceService.create()` always requires one in Sprint 6.
model Invoice {
  id             String   @id @default(cuid())
  organisationId String
  /// Auto-generated (`INV-000001`, ...), globally unique, immutable — same
  /// collision-avoidance loop as `SO-`/`DSP-`.
  invoiceCode    String   @unique
  customerId     String
  outletId       String?
  salesOrderId   String?
  invoiceDate    DateTime
  /// Computed server-side from `invoiceDate + paymentTermDays(paymentTerms)`
  /// at creation — never client-supplied, never recomputed later even if
  /// `paymentTerms` display changes.
  dueDate        DateTime
  paymentTerms   PaymentTermType
  status         InvoiceStatus @default(DRAFT)
  /// Snapshotted from `Organisation.currency` at creation — never re-read
  /// from the organisation later, same "snapshot, don't re-derive" rule as
  /// every commercial value on this model.
  currency       String
  subtotal       Float
  discount       Float         @default(0)
  /// Sum of `InvoiceItem.taxAmount` — deliberately no header-level `taxRate`
  /// column (would drift from per-line reality the moment two lines carry
  /// different rates; nothing would force them to agree).
  taxAmount      Float         @default(0)
  /// `subtotal - discount + taxAmount`, server-computed.
  total          Float
  /// Cumulative, incremented only inside `PaymentRepository.create()`'s
  /// transaction. `amountOutstanding` is deliberately never stored — always
  /// derived as `total - amountPaid - amountCredited` at every read site.
  amountPaid     Float         @default(0)
  /// Cumulative, incremented only inside `CreditNoteRepository.issue()`'s
  /// transaction.
  amountCredited Float         @default(0)
  notes          String?
  /// Client-supplied, optional. Protects `InvoiceService.create()` against a
  /// double-tap/flaky-network retry — same convention as
  /// `SalesFulfilment.idempotencyKey`. NOT a one-invoice-per-order
  /// constraint (that's a separate service-level business-rule check, so a
  /// future partial-invoicing feature needs no migration here).
  idempotencyKey String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  outlet       Outlet?             @relation(fields: [outletId], references: [id], onDelete: Restrict)
  salesOrder   SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]
  allocations  PaymentAllocation[]
  creditNotes  CreditNote[]

  @@unique([salesOrderId, idempotencyKey])
  @@index([organisationId, status])
  @@index([organisationId, customerId])
  @@map("invoices")
}

/// One product line on an `Invoice`, snapshotting commercial detail so
/// historical invoices remain accurate even if the `Product` record's name
/// changes, price assumptions change, or the product later becomes inactive
/// — mirrors `SalesOrderItem`'s own "never reconstruct from the live catalog"
/// rule.
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  /// Snapshot — never re-read from `Product` at display time.
  productCode String
  /// Snapshot.
  productName String
  description String?
  quantity    Float
  unitPrice   Float
  discount    Float    @default(0)
  /// Percent (e.g. `7.5`) — the only place a tax rate lives on an invoice;
  /// defaults to `ConfigService`'s `finance.defaultTaxRatePercent` when the
  /// client omits it, but whatever value is actually used is permanently
  /// snapshotted here, never recomputed from a "current" default later.
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  /// Server-calculated as `roundCurrency(quantity * unitPrice - discount +
  /// taxAmount)` — deliberately absent from `invoiceItemInputSchema` so the
  /// client cannot even express a value.
  lineTotal   Float
  /// Traceability back to the source `SalesOrderItem` this line was
  /// invoiced from.
  salesOrderItemId String?
  createdAt   DateTime @default(now())

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// A customer-scoped (NOT invoice-scoped) record of money received.
/// Deliberately not FK'd directly to one `Invoice` — see `PaymentAllocation`
/// below for why, and docs/domains/finance.md §"Payment Allocation
/// Limitation" for the documented Sprint 6 constraint this enables lifting
/// later without a schema rewrite.
model Payment {
  id             String        @id @default(cuid())
  organisationId String
  customerId     String
  paymentDate    DateTime
  /// Total amount of this payment — may be allocated across one or more
  /// invoices via `PaymentAllocation` (Sprint 6 only ever creates exactly
  /// one allocation row per payment; the join table already supports more).
  amount         Float
  /// Derived server-side from the target Invoice's own snapshotted
  /// `currency` at recording time — never client-supplied (a payment can
  /// only ever apply to its target invoice's own currency).
  currency       String
  method         PaymentMethod
  /// Free-text bank/transaction reference supplied by the customer/payer —
  /// NOT a system-generated code (this codebase's `<PREFIX>-000001` code
  /// numbering is reserved for `Invoice`/`CreditNote` per the brief).
  reference      String?
  notes          String?
  status         PaymentStatus @default(RECORDED)
  /// Client-supplied, optional. Same double-submit protection as every
  /// other idempotency key in this codebase.
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@unique([customerId, idempotencyKey])
  @@index([organisationId])
  @@index([organisationId, customerId])
  @@map("payments")
}

/// The join between a `Payment` and the `Invoice`(s) it was applied to. This
/// is THE design decision satisfying the brief's explicit "design the schema
/// so multi-invoice allocation can be added later without rewriting
/// Payment": a direct `invoiceId` FK on `Payment` itself would require a
/// full schema migration the day multi-invoice allocation is ever needed.
/// This table costs nothing extra today (Sprint 6's `PaymentService.create()`
/// always creates exactly one row here, atomically, alongside its `Payment`)
/// and needs zero migration later — only a service-layer change.
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  /// Portion of the payment applied to this invoice.
  amount    Float
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// The financial consequence of a customer return or commercial adjustment
/// — NOT the physical return itself, which belongs to Sales/Logistics/
/// Inventory (out of scope for this sprint entirely). A lightweight
/// foundation only: a single flat `amount`, no line-item breakdown
/// (`CreditNoteItem` is deferred future work) — matches the brief's own
/// "lightweight" framing and its flat-amount scenario.
model CreditNote {
  id             String           @id @default(cuid())
  organisationId String
  /// Auto-generated (`CN-000001`, ...), globally unique, immutable.
  creditNoteCode String           @unique
  customerId     String
  invoiceId      String?
  reason         String
  amount         Float
  /// Derived server-side from the target Invoice's own snapshotted
  /// `currency` — never client-supplied, same rule as `Payment.currency`.
  currency       String
  status         CreditNoteStatus @default(DRAFT)
  creditNoteDate DateTime
  notes          String?
  idempotencyKey String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, idempotencyKey])
  @@index([organisationId])
  @@index([organisationId, customerId])
  @@map("credit_notes")
}
