# Copy to .env.local — Next.js auto-loads this file for local overrides and it's
# gitignored by default, so this is the ONE file you need for local development. Only
# copy this to a plain `.env` as well if you're running the full containerized stack
# (docker-compose.production.yml), which reads apps/web/.env via env_file — that path
# isn't part of the daily dev workflow, see docs/development/local-development.md.

NODE_ENV=development

# Base URL of the Zentuva API, exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
