# Root environment file — OPTIONAL for day-to-day development.
#
# docker-compose.dev.yml (started via `pnpm infra:up`) already has sensible defaults
# baked in (POSTGRES_USER=zentuva, etc.), so you do NOT need to copy this file just to
# run `pnpm infra:up`. Only copy it to `.env` if you want to override those defaults
# (e.g. a different Postgres port because you have another Postgres running locally).
#
# API_PORT and WEB_PORT below are only read by docker-compose.production.yml (the
# full-stack container build) — they have no effect on `pnpm dev`, which reads ports
# from apps/api/.env and apps/web/.env.local instead. See
# docs/development/local-development.md for the full environment file breakdown.

NODE_ENV=development

# Used by both docker-compose.dev.yml and docker-compose.production.yml.
POSTGRES_USER=zentuva
POSTGRES_PASSWORD=zentuva
POSTGRES_DB=zentuva
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used only by docker-compose.production.yml (full-stack container build).
API_PORT=4000
WEB_PORT=3000
