# Root environment file — used by docker-compose to configure shared infrastructure.
# Copy to .env and adjust as needed. App-specific vars live in apps/api/.env.example
# and apps/web/.env.example.

NODE_ENV=development

POSTGRES_USER=zentuva
POSTGRES_PASSWORD=zentuva
POSTGRES_DB=zentuva
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=4000
WEB_PORT=3000
